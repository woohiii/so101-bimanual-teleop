    { "from": "thread_isolate", "to": "stall_fail", "label": "stalls", "variant": "security", "role": "error" },
    { "from": "stall_fail", "to": "qvga_fix", "label": "diagnose via cadence test", "variant": "dashed", "role": "branch" },
    { "from": "thread_isolate", "to": "qvga_fix" },
    { "from": "qvga_fix", "to": "ship" }
  ],
  "cards": [
    { "dot": "emerald", "title": "Depth Never Went Down", "items": [
      "Depth is the protected resource — it feeds real robot training datasets",
      "After the revert, depth held 0.0-0.01s freshness for 60s+ with zero watchdog restarts",
      "Even during the 25s+ RGB stall, depth stayed completely untouched — proof isolation worked"
    ] },
    { "dot": "amber", "title": "Same Failure Shape, Twice", "items": [
      "This Astra S unit is known-flaky on its color stream",
      "1st time: shared loop — a color hang froze depth too, and the watchdog USB-reset the device mid-session",
      "2nd time: isolated thread — the same kind of hang stayed contained to just the RGB preview"
    ] },
    { "dot": "cyan", "title": "Fix Was Isolation, Not a Guess", "items": [
      "Moved all color-stream device I/O into its own thread with its own cache behind a lock",
      "Deliberately skipped depth-to-color registration — not worth altering recorded depth values for a preview overlay",
      "Root cause of the remaining stall was resolution, not concurrency: QVGA matched depth and fixed it"
    ] }
  ]
