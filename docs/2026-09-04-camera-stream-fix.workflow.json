    { "id": "ship_phase", "label": "Ship", "fromCol": 5, "toCol": 5, "variant": "dashed" }
  ],
  "mainPath": ["goal", "sync_attempt", "revert_verify", "thread_isolate", "qvga_fix", "ship"],
  "nodes": [
    { "id": "goal", "lane": "preview", "col": 0, "type": "frontend", "label": "Add RGB Window + Grasp Overlay", "sublabel": "two-dot towel grip guide", "tag": "camera_preview.py", "width": 208 },
    { "id": "sync_attempt", "lane": "preview", "col": 1, "type": "backend", "label": "Read Color Inline With Depth", "sublabel": "same loop, after depth read", "tag": "color.read_frame()", "width": 194 },
    { "id": "wedge_fail", "lane": "failures", "col": 1, "type": "security", "label": "Color Read Wedges the Loop", "sublabel": "depth publish freezes too", "tag": "watchdog usbreset", "width": 200 },
    { "id": "revert_verify", "lane": "recovery", "col": 2, "type": "backend", "label": "Revert + Verify Depth Stable", "sublabel": "depth stable 60s+, 0 resets", "tag": "git checkout", "width": 194 },
    { "id": "thread_isolate", "lane": "preview", "col": 3, "type": "backend", "label": "Isolate Color in Own Thread", "sublabel": "own frame cache behind a lock", "tag": "threading.Thread + Lock", "width": 204 },
    { "id": "stall_fail", "lane": "failures", "col": 3, "type": "security", "label": "RGB Still Stalls 25s+", "sublabel": "depth unaffected", "tag": "VGA 640x480", "width": 160 },
    { "id": "qvga_fix", "lane": "preview", "col": 4, "type": "backend", "label": "Drop Color to QVGA", "sublabel": "max gap 0.34s over 60s", "tag": "320x240", "width": 156 },
    { "id": "ship", "lane": "preview", "col": 5, "type": "external", "label": "2x2 Grid UI + Ship", "sublabel": "NO SIGNAL placeholders", "tag": "git push x2 repos", "width": 164 }
